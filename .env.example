# Copy to .env and fill in. .env is gitignored and must never be committed.

# Polygon API key. Free tier: 5 requests/minute, two-year lookback.
# Stocks, crypto and forex are separate free subscriptions — check that the key
# covers all three before running a full backfill.
POLYGON_API_KEY=

# Neon Postgres connection string, including ?sslmode=require
DATABASE_URL=
